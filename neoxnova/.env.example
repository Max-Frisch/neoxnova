# Neo-XNova runtime configuration
# Copy to .env; it is auto-loaded on startup during local development.
# In production, set these variables in the process environment instead.

APP_ENV=development
HTTP_ADDR=:8080
UNIVERSE_ID=universe_6_niburu

DATABASE_URL=postgres://postgres:password@localhost:5432/neoxnova?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
