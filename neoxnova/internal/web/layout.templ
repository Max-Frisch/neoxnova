package web

import (
	"strconv"
	"strings"
	"time"

	"neoxnova/internal/models"
)

// Layout is the shared page chrome. Pages call @Page(shell, body) which wraps
// their content in this layout. The shell mirrors the live Niburuspace client:
// a top bar (planet switcher), an htmx-polled resource bar and the full left
// navigation menu.
templ Layout(s Shell) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark"/>
			<meta name="description" content="Neo-XNova — a stateful space MMO."/>
			<link rel="icon" type="image/png" href="/static/niburu/icons/star.png"/>
			<title>{ s.Title } · Neo-XNova</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/skin.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body class="shell-body">
			@TopBar(s)
			if s.ActivePlanetID != 0 {
				@ResourceBar(s)
			}
			<div class="shell">
				if s.ActivePlanetID != 0 {
					<aside class="shell-menu">
						@MainMenu(s)
					</aside>
				}
				<main class="shell-content">
					if s.Flash != "" {
						<div role="status" class="flash">
							<span class="dot"></span>{ s.Flash }
						</div>
					}
					if s.Error != "" {
						<div role="alert" class="error">
							<span class="dot"></span>{ s.Error }
						</div>
					}
					{ children... }
				</main>
			</div>
		</body>
	</html>
}

templ TopBar(s Shell) {
	<header class="topbar">
		<a href="/" class="topbar-logo" title="Overview">Neo-XNova</a>
		if s.ActivePlanetID != 0 {
			<div class="topbar-center">
				<span class="planet-name">{ s.ActivePlanetName }</span>
				if s.ActiveCoords != "" {
					<span class="planet-coords">[{ s.ActiveCoords }]</span>
				}
				if len(s.Planets) > 0 {
					<select id="planet-select" class="planet-select" aria-label="Switch celestial">
						for _, p := range s.Planets {
							<option value={ "/overview/" + strconv.FormatInt(p.ID, 10) } selected?={ p.ID == s.ActivePlanetID }>
								{ p.Name } [{ planetCoords(p) }]
							</option>
						}
					</select>
				}
			</div>
		}
		<div class="topbar-right">
			if s.ActivePlanetID != 0 {
				<a class="topbar-icon" href="/empire" title="Empire">
					<img src="/static/niburu/icons/imperia.png" alt="Empire"/>
				</a>
				<a class="topbar-icon" href={ templ.URL("/reports/" + pid(s)) } title="Messages">
					<img src="/static/niburu/icons/mesages.png" alt="Messages"/>
				</a>
			}
			<span class="topbar-user">{ s.Username }</span>
			<form method="post" action="/logout">
				<button type="submit" class="topbar-logout">Logout</button>
			</form>
		</div>
	</header>
}

// MainMenu reproduces the live left navigation. Menu entries without a backing
// route render as disabled "coming soon" items — never fake pages. `*` in the
// reskin plan maps to @menuDisabled.
templ MainMenu(s Shell) {
	<div class="menu-box">
		<div class="menu-clock">
			<time id="server-clock" data-t={ strconv.FormatInt(s.ServerTime.Unix(), 10) }>{ serverClock(s.ServerTime) }</time>
		</div>
		<div class="menu-pad">
			@menuLink(s, "Overview", "/overview/"+pid(s), true)
			@menuLink(s, "Online Bonus", "/bonus", true)
			@menuDisabled("Premium Account", true)
			@menuDisabled("Antimatter Store", true)
		</div>
		<div class="menu-grid">
			@menuLink(s, "Research", "/research/"+pid(s), false)
			@menuLink(s, "Buildings", "/buildings/"+pid(s), false)
			@menuLink(s, "Hangar", "/shipyard/"+pid(s), false)
			@menuLink(s, "Defenses", "/defenses/"+pid(s), false)
			@menuLink(s, "Fleet", "/fleet/"+pid(s), false)
			@menuLink(s, "Technologies", "/technologies", false)
			@menuLink(s, "Resources", "/resources/"+pid(s), false)
			@menuLink(s, "Senate", "/senate", false)
			@menuLink(s, "Arsenal", "/arsenal", false)
			@menuLink(s, "Academy", "/academy", false)
			@menuDisabled("Achievements", false)
			@menuLink(s, "Black market", "/blackmarket", false)
			@menuLink(s, "Galaxy", "/galaxy", false)
			@menuDisabled("Alliance", false)
			@menuLink(s, "Simulator", "/simulator", false)
			@menuDisabled("Referals", false)
			@menuDisabled("Tournaments", true)
			@menuDisabled("Promote Server", true)
		</div>
	</div>
}

templ menuLink(s Shell, label, href string, wide bool) {
	<a href={ templ.URL(href) } class={ menuClass(s, label, wide) }>{ label }</a>
}

templ menuDisabled(label string, wide bool) {
	if wide {
		<span class="menu-item menu-item--wide is-disabled" title="Coming soon">{ label }</span>
	} else {
		<span class="menu-item is-disabled" title="Coming soon">{ label }</span>
	}
}

func menuClass(s Shell, label string, wide bool) string {
	class := "menu-item"
	if wide {
		class += " menu-item--wide"
	}
	if menuActive(s, label) {
		class += " is-active"
	}
	return class
}

// menuActive highlights the current menu entry. Page titles start with the nav
// label, except a few aliases (Hangar under Shipyard).
func menuActive(s Shell, label string) bool {
	switch label {
	case "Hangar":
		return strings.HasPrefix(s.Title, "Shipyard")
	case "Senate":
		return strings.HasPrefix(s.Title, "Senate") || strings.HasPrefix(s.Title, "Governators")
	}
	return strings.HasPrefix(s.Title, label)
}

func serverClock(t time.Time) string {
	return t.Format("02 Mon Jan 15:04:05")
}

templ ResourceBar(s Shell) {
	<div id="resbar" class="resbar" hx-get={ "/overview/" + pid(s) + "/resources" } hx-trigger="every 5s" hx-swap="outerHTML">
		@resourceItems(s)
	</div>
}

templ resourceItems(s Shell) {
	if s.Resources != nil {
		@resCapacity("metal", "metall.gif", "Metal", s.Resources.MetalCurrent, float64(s.Resources.MetalLimit), s.Resources.MetalHourlyRate)
		@resCapacity("crystal", "kristall.gif", "Crystal", s.Resources.CrystalCurrent, float64(s.Resources.CrystalLimit), s.Resources.CrystalHourlyRate)
		@resCapacity("deut", "deuterium.gif", "Deuterium", s.Resources.DeutCurrent, float64(s.Resources.DeutLimit), s.Resources.DeutHourlyRate)
		<div class={ energyClass(s.Resources) }>
			<img class="res-icon" src="/static/niburu/icons/energie.gif" alt="Energy"/>
			<span class="res-value">{ fnum(int64(s.Resources.EnergyAvailable)) }</span>
			<span class="res-cap">/ { fnum(int64(s.Resources.EnergyMax)) }</span>
		</div>
		@resValue("stardust", "stardust_mini.gif", "Stardust", s.Resources.Stardust)
		@resValue("dm", "darkmatter.gif", "Dark Matter", s.Resources.DarkMatter)
		@resValue("am", "atm.gif", "Antimatter", s.Resources.Antimatter)
	}
}

templ resCapacity(kind, icon, label string, cur, limit, rate float64) {
	<div class={ "res res--" + kind }>
		<img class="res-icon" src={ "/static/niburu/icons/" + icon } alt={ label } title={ label }/>
		<span class="res-value">{ fnumF(cur) }</span>
		<span class="res-cap">/ { fnum(int64(limit)) }</span>
		<span class="res-pct">({ pctStr(cur, limit) }%)</span>
		<span class="res-rate">+{ fnumF(rate) }/h</span>
		<span class="res-fill" data-pct={ pctStr(cur, limit) }></span>
	</div>
}

templ resValue(kind, icon, label string, val int64) {
	<div class={ "res res--" + kind }>
		<img class="res-icon" src={ "/static/niburu/icons/" + icon } alt={ label } title={ label }/>
		<span class="res-value">{ fnum(val) }</span>
	</div>
}

func energyClass(r *models.RealtimeResourceState) string {
	if r.EnergyAvailable < 0 {
		return "res res--energy is-negative"
	}
	return "res res--energy"
}

// pctStr renders cur/limit as an integer percentage clamped to [0,100] for a
// CSP-safe bar width handed to app.js via data-pct.
func pctStr(cur, limit float64) string {
	if limit <= 0 {
		return "0"
	}
	p := int(cur/limit*100 + 0.5)
	if p < 0 {
		p = 0
	} else if p > 100 {
		p = 100
	}
	return strconv.Itoa(p)
}

func pid(s Shell) string {
	return strconv.FormatInt(s.ActivePlanetID, 10)
}

func planetCoords(p models.OwnedCelestial) string {
	return strconv.Itoa(p.Galaxy) + ":" + strconv.Itoa(p.System) + ":" + strconv.Itoa(p.Position)
}
