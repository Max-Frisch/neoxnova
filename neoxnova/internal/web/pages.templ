package web

import (
	"strconv"

	"neoxnova/internal/game"
	"neoxnova/internal/models"
	"neoxnova/internal/store"
)

// Page wraps body content in the shared layout.
templ Page(s Shell, body templ.Component) {
	@Layout(s) {
		@body
	}
}

templ EmptyPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="color-scheme" content="dark"/>
			<title>Neo-XNova</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/skin.css"/>
		</head>
		<body class="auth-body p-8">
			<div class="mx-auto max-w-lg rounded-lg border border-slate-800 bg-slate-900/60 p-6">
				<h1 class="text-xl font-bold text-cyan-400">No planet found</h1>
				<p class="mt-2 text-sm text-slate-400">Your account has no celestial object. Register a fresh account or run the seed.</p>
				<form method="post" action="/logout" class="mt-4">
					<button class="rounded bg-slate-800 px-3 py-1 text-sm text-rose-300">Logout</button>
				</form>
			</div>
		</body>
	</html>
}

templ AuthPage(a AuthView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark"/>
			<link rel="icon" type="image/png" href="/static/niburu/icons/star.png"/>
			<title>{ a.Mode } · Neo-XNova</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/skin.css"/>
		</head>
		<body class="auth-body flex items-center justify-center p-4">
			<div class="w-full max-w-sm rounded-lg border border-slate-800 bg-slate-900/60 p-6">
				<h1 class="mb-4 text-2xl font-bold text-cyan-400">Neo-XNova</h1>
				if a.Error != "" {
					<div class="mb-4 rounded border border-rose-700 bg-rose-900/40 px-3 py-2 text-sm text-rose-200">{ a.Error }</div>
				}
				if a.Mode == "register" {
					<form method="post" action="/register" class="space-y-3">
						<label class="block text-sm text-slate-300">Username
							<input name="username" value={ a.Login } required class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-3 py-2"/>
						</label>
						<label class="block text-sm text-slate-300">Email
							<input name="email" type="email" value={ a.Email } required class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-3 py-2"/>
						</label>
						<label class="block text-sm text-slate-300">Password
							<input name="password" type="password" minlength="10" required class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-3 py-2"/>
						</label>
						<button type="submit" class="w-full rounded bg-cyan-600 px-3 py-2 font-semibold text-white hover:bg-cyan-500">Create account</button>
						<p class="text-center text-sm text-slate-400">Have an account? <a href="/login" class="text-cyan-400">Log in</a></p>
					</form>
				} else {
					<form method="post" action="/login" class="space-y-3">
						<label class="block text-sm text-slate-300">Username or email
							<input name="login" value={ a.Login } required class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-3 py-2"/>
						</label>
						<label class="block text-sm text-slate-300">Password
							<input name="password" type="password" required class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-3 py-2"/>
						</label>
						<button type="submit" class="w-full rounded bg-cyan-600 px-3 py-2 font-semibold text-white hover:bg-cyan-500">Log in</button>
						<p class="text-center text-sm text-slate-400">No account? <a href="/register" class="text-cyan-400">Register</a></p>
					</form>
				}
			</div>
		</body>
	</html>
}

// ---- Overview body -------------------------------------------------------

templ OverviewBody(sh Shell, d OverviewData) {
	<section class="panel overview">
		<div class="overview-hero">
			<div class="overview-activity">
				@activityRow("Research:", activityLabel(d.ResQueue), "/research/"+pid(sh))
				@activityRow("Buildings:", activityLabel(d.BuildQueue), "/buildings/"+pid(sh))
				@activityRow("Hangar:", activityLabel(d.ShipQueue), "/shipyard/"+pid(sh))
			</div>
			<div class="overview-planet">
				<span class="overview-planet-name">{ celestialLabel(d.Overview.Coordinates.Type) } "{ d.Overview.ActivePlanetName }"</span>
			</div>
		</div>
		<div class="overview-stats">
			<span>Diameter <b>{ fnum(int64(d.Overview.DiameterKm)) } km</b></span>
			<span>Position <b>{ coordStr(d.Overview.Coordinates) }</b></span>
			<span>Temperature <b>{ strconv.Itoa(d.Overview.TempRange[0]) }°C to { strconv.Itoa(d.Overview.TempRange[1]) }°C</b></span>
			<span>Fields <b>{ strconv.Itoa(d.Overview.FieldsUsed) } / { strconv.Itoa(d.Overview.FieldsMax) }</b></span>
			<span>Points <b>{ fnum(d.Overview.PlayerRank.Points) } (#{ strconv.Itoa(d.Overview.PlayerRank.Position) })</b></span>
		</div>
	</section>

	<div class="overview-links">
		<a href={ templ.URL("/buildings/" + pid(sh)) }>Buildings</a>
		<a href={ templ.URL("/shipyard/" + pid(sh)) }>Shipyard</a>
		<a href={ templ.URL("/research/" + pid(sh)) }>Research</a>
		<a href={ templ.URL("/fleet/" + pid(sh)) }>Fleet</a>
		<a href={ templ.URL("/expedition/" + pid(sh)) }>Expedition</a>
		<a href="/galaxy">Galaxy</a>
	</div>

	<div class="grid gap-6 lg:grid-cols-3">
		<section class="panel lg:col-span-2">
			<h3 class="panel-title">Active fleets</h3>
			if len(d.Overview.ActiveFleets) == 0 {
				<p class="text-sm text-slate-500">No fleets in flight.</p>
			} else {
				<div class="overflow-x-auto">
					<table class="game-table">
						<thead>
							<tr><th>Mission</th><th>Phase</th><th>Route</th><th>Arrives in</th><th>Types</th></tr>
						</thead>
						<tbody>
							for _, f := range d.Overview.ActiveFleets {
								<tr>
									<td>{ string(f.Mission) }</td>
									<td>{ string(f.Phase) }</td>
									<td>{ coordStr(f.Origin) } → { coordStr(f.Destination) }</td>
									<td><span data-countdown={ strconv.FormatInt(f.ArrivalTime.Unix(), 10) } data-cd-format="dur">{ dur(f.RemainingSecs) }</span></td>
									<td>{ strconv.Itoa(len(f.ShipManifest)) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		<section class="panel">
			<h3 class="panel-title">Levels &amp; Rank</h3>
			<p class="text-sm text-slate-400">Peaceful L{ strconv.Itoa(d.Overview.Levels.PeacefulLevel) } · Combat L{ strconv.Itoa(d.Overview.Levels.CombatLevel) } ({ fnum(d.Overview.Levels.CombatXP) } XP)</p>
			<p class="mt-2 text-sm text-slate-400">Rank #{ strconv.Itoa(d.Overview.PlayerRank.Position) } of { strconv.Itoa(d.Overview.PlayerRank.TotalPlayers) } · { fnum(d.Overview.PlayerRank.Points) } pts</p>
		</section>
	</div>

	<section class="panel mt-6">
		<h3 class="panel-title">Incoming</h3>
		if len(d.Incoming) == 0 {
			<p class="text-sm text-slate-500">Nothing inbound.</p>
		} else {
			<table class="game-table">
				<thead><tr><th>Mission</th><th>From</th><th>Arrives in</th></tr></thead>
				<tbody>
					for _, f := range d.Incoming {
						<tr>
							<td>{ f.MissionText }</td>
							<td>{ coordStr(f.Origin) }</td>
							<td><span data-countdown={ strconv.FormatInt(f.ArrivalTime.Unix(), 10) } data-cd-format="dur">{ dur(f.RemainingSecs) }</span></td>
						</tr>
					}
				</tbody>
			</table>
		}
	</section>
}

templ activityRow(label, value, href string) {
	<div class="activity-row">
		<span class="activity-label">{ label }</span>
		<a class="activity-value" href={ templ.URL(href) }>{ value }</a>
	</div>
}

// ---- Buildings body ------------------------------------------------------

templ BuildingsBody(sh Shell, d BuildingsData) {
	<div id="buildings-panel" hx-get={ "/buildings/" + pid(sh) + "/status" } hx-trigger="every 5s" hx-swap="outerHTML" hx-include="#buildings-sig">
		<input type="hidden" id="buildings-sig" name="sig" value={ d.Sig }/>
		<section class="panel">
			<div class="fields-bar">
				<span class="help" title={ fieldsHelp(d.IsMoon) }>?</span>
				<span>Fields occupied: <b>{ strconv.Itoa(d.FieldsUsed) }</b> from { strconv.Itoa(d.FieldsMax) }</span>
				<span class="fields-free">Free: { strconv.Itoa(d.FieldsMax - d.FieldsUsed) }</span>
				<button type="button" class="dm-buy" disabled title="Coming soon">Buy with Dark matter.</button>
			</div>
			if d.IsMoon {
				<div class="mb-3 flex gap-2 text-sm">
					<a class="rounded bg-slate-800 px-3 py-1 hover:bg-slate-700" href={ templ.URL("/jumpgate/" + pid(sh)) }>Jumpgate</a>
					<a class="rounded bg-slate-800 px-3 py-1 hover:bg-slate-700" href={ templ.URL("/phalanx/" + pid(sh)) }>Phalanx Sensor</a>
				</div>
			}
			if len(d.Queue) > 0 {
				for i, q := range d.Queue {
					@queueRow(i+1, displayName(q.Code)+" "+strconv.Itoa(q.TargetLevel), q, "/buildings/"+pid(sh)+"/cancel")
				}
			}
			<div class="card-grid">
				for _, it := range d.Items {
					@buildCard(sh, it, d.Resources)
				}
			</div>
		</section>
	</div>
}

templ buildCard(sh Shell, it BuildItem, have ResourceStock) {
	<div class="gcard">
		<div class="gcard-head">
			<span class="gcard-title">{ itemTitle(it.Name, it.Level) }</span>
			if it.Code == "jumpgate" {
				<a class="text-xs text-cyan-300 underline" href={ templ.URL("/jumpgate/" + pid(sh)) }>[Jump]</a>
			} else if it.Code == "phalanx_sensor" {
				<a class="text-xs text-cyan-300 underline" href={ templ.URL("/phalanx/" + pid(sh)) }>[Scan]</a>
			}
			<span class="help" title={ it.Name }>?</span>
		</div>
		<div class="gcard-body">
			if it.Image != "" {
				<img class="gcard-img" src={ it.Image } alt={ it.Name }/>
			}
			if it.Unlocked {
				<div class="gcard-info">
					<div data-cost-total>
						@costRowsWithStock(it.Cost, have)
					</div>
					@energyNote(it.EnergyDelta)
					if it.DurationSecs > 0 {
						<span class="gcard-duration">Duration: <span data-duration-total>{ hms(it.DurationSecs) }</span></span>
					}
				</div>
			} else {
				@prereqBlock("Necessary for the construction:", it.Prereqs)
			}
		</div>
		<div class="gcard-foot">
			if it.Unlocked {
				<form method="post" action={ templ.URL("/buildings/" + pid(sh) + "/build") } class="build-form" data-cost-table={ costTableJSON(it.CostTable) }>
					<input type="hidden" name="code" value={ it.Code }/>
					<button type="submit" class="build-next">Build to the next level</button>
					<input class="build-level" name="target_level" type="number" inputmode="numeric" min={ strconv.Itoa(it.NextLevel) } max={ strconv.Itoa(it.MaxLevel) } value={ strconv.Itoa(it.NextLevel) } data-level-input/>
					<button type="submit" class="build-up" title="Build">▲</button>
				</form>
			}
		</div>
	</div>
}

// queueRow is one active-queue line with an htmx-free cancel form (the cancel X
// posts to cancelURL and redirects back with a flash).
templ queueRow(n int, label string, q models.QueueEntrySummary, cancelURL string) {
	<div class="queue-row">
		<span class="queue-n">{ strconv.Itoa(n) }.</span>
		<span class="queue-label">{ label }</span>
		<span class="queue-cost">{ costStr(q.Cost) }</span>
		<span class="queue-end">Ending: { endTimeStr(q.EndTime) }</span>
		<span class="queue-remain" data-countdown={ strconv.FormatInt(q.EndTime.Unix(), 10) }>{ hms(q.RemainingSecs) }</span>
		<form method="post" action={ templ.URL(cancelURL) }>
			<input type="hidden" name="queue_id" value={ strconv.FormatInt(q.ID, 10) }/>
			<button type="submit" class="queue-cancel" title="Cancel">✕</button>
		</form>
	</div>
}

templ costRows(cost models.CargoManifest) {
	<div class="cost">
		if cost.Metal > 0 {
			@costRow("/static/niburu/icons/metall_mini.gif", "Metal", cost.Metal, false)
		}
		if cost.Crystal > 0 {
			@costRow("/static/niburu/icons/kristall_mini.gif", "Crystal", cost.Crystal, false)
		}
		if cost.Deuterium > 0 {
			@costRow("/static/niburu/icons/deuterium_mini.gif", "Deuterium", cost.Deuterium, false)
		}
	</div>
}

// costRowsWithStock is costRows that colours each resource red when the
// celestial cannot currently cover it.
templ costRowsWithStock(cost models.CargoManifest, have ResourceStock) {
	<div class="cost">
		if cost.Metal > 0 {
			@costRow("/static/niburu/icons/metall_mini.gif", "Metal", cost.Metal, float64(cost.Metal) > have.Metal)
		}
		if cost.Crystal > 0 {
			@costRow("/static/niburu/icons/kristall_mini.gif", "Crystal", cost.Crystal, float64(cost.Crystal) > have.Crystal)
		}
		if cost.Deuterium > 0 {
			@costRow("/static/niburu/icons/deuterium_mini.gif", "Deuterium", cost.Deuterium, float64(cost.Deuterium) > have.Deuterium)
		}
	</div>
}

templ costRow(icon, alt string, amount int64, short bool) {
	<span class={ costRowClass(short) }><img src={ icon } alt={ alt }/>{ fnum(amount) }</span>
}

func costRowClass(short bool) string {
	if short {
		return "cost-row short"
	}
	return "cost-row"
}

templ energyNote(delta float64) {
	if delta < 0 {
		<span class="energy need">Need more { fnumF(-delta) } energy</span>
	} else if delta > 0 {
		<span class="energy gain">Produced { fnumF(delta) } energy</span>
	}
}

templ prereqBlock(label string, prereqs []Prereq) {
	<div class="prereq">
		<span class="prereq-label">{ label }</span>
		<div class="prereq-list">
			for _, p := range prereqs {
				<span class={ prereqClass(p) } title={ p.Name + " " + strconv.Itoa(p.Current) + "/" + strconv.Itoa(p.Required) }>
					if p.Image != "" {
						<img src={ p.Image } alt={ p.Name }/>
					}
					<span class="prereq-lvl">{ strconv.Itoa(p.Current) }/{ strconv.Itoa(p.Required) }</span>
				</span>
			}
		</div>
	</div>
}

func celestialLabel(t models.CelestialType) string {
	if t == models.TypeMoon {
		return "Moon"
	}
	return "Planet"
}

func fieldsHelp(isMoon bool) string {
	if isMoon {
		return "Fields used by structures on this moon"
	}
	return "Fields used by structures on this planet"
}

func prereqClass(p Prereq) string {
	if p.Current >= p.Required {
		return "prereq-item is-met"
	}
	return "prereq-item"
}

func itemTitle(name string, level int) string {
	if level > 0 {
		return name + " " + strconv.Itoa(level) + " Level"
	}
	return name
}

// activityLabel summarises an active queue entry for the overview hero.
func activityLabel(q *models.QueueEntrySummary) string {
	if q == nil {
		return "Nothing in progress"
	}
	if q.Quantity > 0 {
		return displayName(q.Code) + " × " + fnum(q.Quantity)
	}
	return displayName(q.Code) + " " + strconv.Itoa(q.TargetLevel)
}

// ---- Shipyard / Defenses bodies -----------------------------------------

templ ShipyardBody(sh Shell, d ShipyardData) {
	<div id="shipyard-panel" hx-get={ "/shipyard/" + pid(sh) + "/status" } hx-trigger="every 5s" hx-swap="outerHTML" hx-include="#shipyard-sig">
		<input type="hidden" id="shipyard-sig" name="sig" value={ d.Sig }/>
		@unitSections(sh, d, "/shipyard/"+pid(sh)+"/build", "/shipyard/"+pid(sh)+"/cancel")
	</div>
}

templ DefensesBody(sh Shell, d ShipyardData) {
	<div id="defenses-panel" hx-get={ "/defenses/" + pid(sh) + "/status" } hx-trigger="every 5s" hx-swap="outerHTML" hx-include="#defenses-sig">
		<input type="hidden" id="defenses-sig" name="sig" value={ d.Sig }/>
		@unitSections(sh, d, "/defenses/"+pid(sh)+"/build", "/defenses/"+pid(sh)+"/cancel")
	</div>
}

templ unitSections(sh Shell, d ShipyardData, buildPath, cancelPath string) {
	<section class="panel">
		<div class="fields-bar">
			<span class="help" title="Ships and defenses built at this planet">?</span>
			<button type="button" class="dm-buy" disabled title="Coming soon">Buy with Dark matter.</button>
		</div>
		if len(d.Queue) > 0 {
			for i, q := range d.Queue {
				@queueRow(i+1, displayName(q.Code)+" × "+fnum(q.Quantity), q, cancelPath)
			}
		}
		for _, sec := range d.Sections {
			<h3 class="unit-section">{ sec.Title }</h3>
			<div class="card-grid">
				for _, it := range sec.Items {
					@unitCard(sh, it, buildPath)
				}
			</div>
		}
	</section>
}

templ unitCard(sh Shell, it UnitItem, buildPath string) {
	<div class="gcard">
		<div class="gcard-head">
			<span class="gcard-title">{ unitTitle(it.Name, it.Count) }</span>
			<span class="help" title={ it.Name }>?</span>
		</div>
		<div class="gcard-body">
			if it.Image != "" {
				<img class="gcard-img" src={ it.Image } alt={ it.Name }/>
			}
			if it.Unlocked {
				<div class="gcard-info">
					<div data-cost-total>
						@costRows(it.Cost)
					</div>
					if it.DurationSecs > 0 {
						<span class="gcard-duration">Duration: <span data-duration-total>{ hms(it.DurationSecs) }</span></span>
					}
				</div>
			} else {
				@prereqBlock("Necessary for the construction:", it.Prereqs)
			}
		</div>
		<div class="gcard-foot">
			if it.Unlocked {
				<form method="post" action={ templ.URL(buildPath) } class="unit-form" data-unit-cost={ unitCostJSON(it.Cost) } data-unit-time={ strconv.FormatInt(it.DurationSecs, 10) }>
					<input type="hidden" name="code" value={ it.Code }/>
					<input id={ "q_" + it.Code } class="build-level unit-qty" name="quantity" type="text" inputmode="numeric" value="1" data-unit-input/>
					<button type="button" class="unit-max" data-target={ "q_" + it.Code } data-max={ strconv.FormatInt(it.MaxQty, 10) }>Max</button>
					<button type="submit" class="build-next">Build</button>
				</form>
			}
		</div>
	</div>
}

func unitTitle(name string, count int64) string {
	if count > 0 {
		return name + " (" + fnum(count) + ")"
	}
	return name
}

// ---- Research body -------------------------------------------------------

templ ResearchBody(sh Shell, d ResearchData) {
	<div id="research-panel" hx-get={ "/research/" + pid(sh) + "/status" } hx-trigger="every 5s" hx-swap="outerHTML" hx-include="#research-sig">
		<input type="hidden" id="research-sig" name="sig" value={ d.Sig }/>
		<section class="panel">
			<div class="fields-bar">
				<span class="help" title="Technologies researched account-wide">?</span>
				<button type="button" class="dm-buy" disabled title="Coming soon">Buy with Dark matter.</button>
			</div>
			if len(d.Queue) > 0 {
				for i, q := range d.Queue {
					@queueRow(i+1, displayName(q.Code)+" "+strconv.Itoa(q.TargetLevel), q, "/research/"+pid(sh)+"/cancel")
				}
			}
			<div class="card-grid">
				for _, it := range d.Items {
					@researchCard(sh, it, d.Resources)
				}
			</div>
		</section>
	</div>
}

templ researchCard(sh Shell, it ResearchItem, have ResourceStock) {
	<div class="gcard">
		<div class="gcard-head">
			<span class="gcard-title">{ itemTitle(it.Name, it.Level) }</span>
			<span class="help" title={ it.Name }>?</span>
		</div>
		<div class="gcard-body">
			if it.Image != "" {
				<img class="gcard-img" src={ it.Image } alt={ it.Name }/>
			}
			if it.Unlocked {
				<div class="gcard-info">
					<div data-cost-total>
						@costRowsWithStock(it.Cost, have)
					</div>
					if it.DurationSecs > 0 {
						<span class="gcard-duration">Duration: <span data-duration-total>{ hms(it.DurationSecs) }</span></span>
					}
					if it.EnergyReq > 0 {
						if it.EnergyMet {
							<span class="energy gain">Energy { fnum(it.EnergyReq) } required · { fnumF(it.EnergyHave) } produced</span>
						} else {
							<span class="energy need">Energy { fnum(it.EnergyReq) } required · { fnumF(it.EnergyHave) } produced</span>
						}
					}
				</div>
			} else {
				@prereqBlock("For research is needed:", it.Prereqs)
			}
		</div>
		<div class="gcard-foot">
			if it.Unlocked && (it.EnergyReq == 0 || it.EnergyMet) {
				<form method="post" action={ templ.URL("/research/" + pid(sh) + "/start") } class="build-form" data-cost-table={ costTableJSON(it.CostTable) }>
					<input type="hidden" name="code" value={ it.Code }/>
					<button type="submit" class="build-next">Research to the next level</button>
					<input class="build-level" name="target_level" type="number" inputmode="numeric" min={ strconv.Itoa(it.NextLevel) } max={ strconv.Itoa(it.MaxLevel) } value={ strconv.Itoa(it.NextLevel) } data-level-input/>
					<button type="submit" class="build-up" title="Research">▲</button>
				</form>
			} else if it.Unlocked {
				<span class="energy need">Not enough energy production</span>
			}
		</div>
	</div>
}

// ---- Fleet body ----------------------------------------------------------

templ FleetBody(sh Shell, d FleetData) {
	<div class="overview-links">
		<a href={ templ.URL("/expedition/" + pid(sh)) }>Expedition command</a>
	</div>
	<div class="grid gap-6 lg:grid-cols-2">
		<section class="panel">
			<h3 class="panel-title">Dispatch</h3>
			<form method="post" action={ templ.URL("/fleet/" + pid(sh) + "/dispatch") } class="space-y-3 text-sm">
				<div class="grid grid-cols-2 gap-2">
					<label class="block text-slate-300">Mission
						<select name="mission" class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-2 py-1">
							<option value="TRANSPORT" selected?={ d.Mission == "TRANSPORT" }>Transport</option>
							<option value="DEPLOY" selected?={ d.Mission == "DEPLOY" }>Deploy</option>
							<option value="ATTACK" selected?={ d.Mission == "ATTACK" }>Attack</option>
							<option value="ESPIONAGE" selected?={ d.Mission == "ESPIONAGE" }>Espionage</option>
							<option value="RECYCLE" selected?={ d.Mission == "RECYCLE" }>Recycle</option>
							<option value="COLONIZE" selected?={ d.Mission == "COLONIZE" }>Colonize</option>
							<option value="EXPEDITION" selected?={ d.Mission == "EXPEDITION" }>Expedition</option>
							<option value="DESTROY_MOON" selected?={ d.Mission == "DESTROY_MOON" }>Destroy moon</option>
						</select>
					</label>
					<label class="block text-slate-300">Target type
						<select name="target_type" class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-2 py-1">
							<option value="PLANET" selected?={ d.TargetType == "PLANET" }>Planet</option>
							<option value="MOON" selected?={ d.TargetType == "MOON" }>Moon</option>
							<option value="DEBRIS_FIELD" selected?={ d.TargetType == "DEBRIS_FIELD" }>Debris</option>
							<option value="DEEP_SPACE" selected?={ d.TargetType == "DEEP_SPACE" }>Deep space</option>
						</select>
					</label>
				</div>
				<div class="grid grid-cols-3 gap-2">
					<label class="block text-slate-300">Galaxy<input name="galaxy" type="number" min="1" max="9" value={ strconv.Itoa(d.TargetG) } class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-2 py-1"/></label>
					<label class="block text-slate-300">System<input name="system" type="number" min="1" max="499" value={ strconv.Itoa(d.TargetS) } class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-2 py-1"/></label>
					<label class="block text-slate-300">Position<input name="position" type="number" min="1" max="21" value={ strconv.Itoa(d.TargetP) } class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-2 py-1"/></label>
				</div>
				<div class="grid grid-cols-3 gap-2">
					<label class="block text-slate-300">Speed %<input name="speed_percent" type="number" min="10" max="100" value="100" class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-2 py-1"/></label>
					<label class="block text-slate-300">Hold (h)<input name="holding_hours" type="number" min="0" max="24" value="0" class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-2 py-1"/></label>
					<label class="block text-slate-300">Cargo metal<input name="cargo_metal" type="number" min="0" value="0" class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-2 py-1"/></label>
				</div>
				<div class="grid grid-cols-2 gap-2">
					<label class="block text-slate-300">Cargo crystal<input name="cargo_crystal" type="number" min="0" value="0" class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-2 py-1"/></label>
					<label class="block text-slate-300">Cargo deuterium<input name="cargo_deuterium" type="number" min="0" value="0" class="mt-1 w-full rounded border border-slate-700 bg-slate-950 px-2 py-1"/></label>
				</div>
				<div>
					<p class="mb-1 text-slate-400">Ships</p>
					<div class="grid grid-cols-2 gap-1">
						for _, s := range d.Ships {
							<label class="flex items-center justify-between gap-2 rounded bg-slate-950/60 px-2 py-1">
								<span class="truncate text-xs text-slate-300">{ s.Name } ({ fnum(s.Count) })</span>
								<input name={ "ship_" + s.Code } type="number" min="0" max={ strconv.FormatInt(s.Count, 10) } value="0" class="w-20 rounded border border-slate-700 bg-slate-950 px-1 py-0.5 text-right"/>
							</label>
						}
					</div>
				</div>
				<button type="submit" class="build-next">Dispatch fleet</button>
			</form>
		</section>
		<section class="space-y-6">
			<div class="panel">
				<h3 class="panel-title">Your fleets</h3>
				if len(d.Fleets) == 0 {
					<p class="text-sm text-slate-500">No fleets in flight.</p>
				} else {
					<table class="game-table">
						<thead><tr><th>Mission</th><th>Phase</th><th>Arrives</th><th></th></tr></thead>
						<tbody>
							for _, f := range d.Fleets {
								<tr>
									<td>{ string(f.Mission) }</td>
									<td>{ string(f.Phase) }</td>
									<td><span data-countdown={ strconv.FormatInt(f.ArrivalTime.Unix(), 10) } data-cd-format="dur">{ dur(f.RemainingSecs) }</span></td>
									<td>
										<form method="post" action={ templ.URL("/fleet/" + pid(sh) + "/recall") }>
											<input type="hidden" name="fleet_id" value={ strconv.FormatInt(f.FleetID, 10) }/>
											<button class="queue-cancel">Recall</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
			<div class="panel">
				<h3 class="panel-title">Incoming</h3>
				if len(d.Incoming) == 0 {
					<p class="text-sm text-slate-500">Nothing inbound.</p>
				} else {
					<table class="game-table">
						<thead><tr><th>Mission</th><th>From</th><th>Arrives</th></tr></thead>
						<tbody>
							for _, f := range d.Incoming {
								<tr>
									<td>{ f.MissionText }</td>
									<td>{ coordStr(f.Origin) }</td>
									<td><span data-countdown={ strconv.FormatInt(f.ArrivalTime.Unix(), 10) } data-cd-format="dur">{ dur(f.RemainingSecs) }</span></td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
		</section>
	</div>
}

// ---- Resources body ------------------------------------------------------

templ ResourcesBody(sh Shell, d ResourcesData) {
	<div class="panel resource-panel">
		<div class="resource-head">
			<h2 class="panel-title">Resources</h2>
			<span class="resource-sub">Resources produced on the planet "{ d.Planet }"</span>
		</div>
		<div class="overflow-x-auto">
			<table class="game-table resource-table">
				<thead>
					<tr><th></th><th class="num">Metal</th><th class="num">Crystal</th><th class="num">Deuterium</th><th class="num">Energy</th><th></th></tr>
				</thead>
				<tbody>
					for _, l := range d.Breakdown.Lines {
						<tr>
							<td class="res-name">{ resLineLabel(l) }</td>
							<td class="num res-metal">{ resAmount(l.Metal) }</td>
							<td class="num res-crystal">{ resAmount(l.Crystal) }</td>
							<td class="num res-deut">{ resAmount(l.Deuterium) }</td>
							<td class="num res-energy">{ energyAmount(l.Energy) }</td>
							<td class="pct-cell">
								if l.Code != "" {
									<span class="prod-pct">{ strconv.Itoa(l.Percent) }%</span>
								}
							</td>
						</tr>
					}
					<tr class="res-bonus">
						<td class="res-name">{ d.Breakdown.Bonus.Name }</td>
						<td class="num res-metal">{ resAmount(d.Breakdown.Bonus.Metal) }</td>
						<td class="num res-crystal">{ resAmount(d.Breakdown.Bonus.Crystal) }</td>
						<td class="num res-deut">{ resAmount(d.Breakdown.Bonus.Deuterium) }</td>
						<td class="num res-energy"></td>
						<td></td>
					</tr>
					<tr class="res-storage">
						<td class="res-name">Storage capacity</td>
						<td class="num res-metal">{ resAmount(d.Breakdown.Storage.Metal) }</td>
						<td class="num res-crystal">{ resAmount(d.Breakdown.Storage.Crystal) }</td>
						<td class="num res-deut">{ resAmount(d.Breakdown.Storage.Deuterium) }</td>
						<td class="num res-energy">-</td>
						<td></td>
					</tr>
					<tr class="res-total">
						<td class="res-name">Total</td>
						<td class="num res-metal">{ resAmount(d.Breakdown.Total.Metal) }</td>
						<td class="num res-crystal">{ resAmount(d.Breakdown.Total.Crystal) }</td>
						<td class="num res-deut">{ resAmount(d.Breakdown.Total.Deuterium) }</td>
						<td class="num res-energy">{ energyAmount(d.Breakdown.Total.Energy) }</td>
						<td></td>
					</tr>
					<tr>
						<td class="res-name">Daily Production</td>
						<td class="num res-metal">{ resAmount(d.Breakdown.Total.Metal * 24) }</td>
						<td class="num res-crystal">{ resAmount(d.Breakdown.Total.Crystal * 24) }</td>
						<td class="num res-deut">{ resAmount(d.Breakdown.Total.Deuterium * 24) }</td>
						<td class="num res-energy">{ energyAmount(d.Breakdown.Total.Energy) }</td>
						<td></td>
					</tr>
					<tr>
						<td class="res-name">Weekly Production</td>
						<td class="num res-metal">{ resAmount(d.Breakdown.Total.Metal * 24 * 7) }</td>
						<td class="num res-crystal">{ resAmount(d.Breakdown.Total.Crystal * 24 * 7) }</td>
						<td class="num res-deut">{ resAmount(d.Breakdown.Total.Deuterium * 24 * 7) }</td>
						<td class="num res-energy">{ energyAmount(d.Breakdown.Total.Energy) }</td>
						<td></td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
}

// ---- Galaxy body ---------------------------------------------------------

templ GalaxyBody(sh Shell, d GalaxyData) {
	<div class="panel galaxy-panel">
		<div class="galaxy-toolbar">
			<div class="galaxy-stepper">
				<span class="galaxy-label">Galaxy:</span>
				<a class="galaxy-arrow" href={ templ.URL(galaxyURL(d.Scan.Galaxy-1, d.Scan.System)) } title="Previous galaxy">◄</a>
				<span class="galaxy-coord">{ strconv.Itoa(d.Scan.Galaxy) }</span>
				<a class="galaxy-arrow" href={ templ.URL(galaxyURL(d.Scan.Galaxy+1, d.Scan.System)) } title="Next galaxy">►</a>
			</div>
			<div class="galaxy-stepper">
				<span class="galaxy-label">System:</span>
				<a class="galaxy-arrow" href={ templ.URL(galaxyURL(d.Scan.Galaxy, d.Scan.System-1)) } title="Previous system">◄</a>
				<span class="galaxy-coord">{ strconv.Itoa(d.Scan.System) }</span>
				<a class="galaxy-arrow" href={ templ.URL(galaxyURL(d.Scan.Galaxy, d.Scan.System+1)) } title="Next system">►</a>
			</div>
			<div class="galaxy-toolbar-spacer"></div>
			<button type="button" class="btn is-disabled" title="Coming soon" disabled>Saved</button>
			<button type="button" class="btn is-disabled" title="Coming soon" disabled>View</button>
		</div>
		<div class="overflow-x-auto">
			<table class="game-table galaxy-table">
				<thead>
					<tr>
						<th class="gal-num">Nº</th>
						<th>Planet Name (Activity)</th>
						<th class="gal-moon">Moon</th>
						<th>Debris</th>
						<th>Player (State)</th>
						<th>Alliance</th>
						<th class="gal-actions">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, slot := range d.Scan.Slots {
						if slot.Position == 21 {
							<tr class="gal-deepspace">
								<td class="gal-num">21</td>
								<td colspan="6"><span class="gal-deepspace-bar">Deep area of galaxy</span></td>
							</tr>
						} else {
							@galaxyRow(sh, slot, d.Scan.Galaxy, d.Scan.System)
						}
					}
				</tbody>
			</table>
		</div>
		<div class="galaxy-footer">
			<div class="gal-stat"><span class="gal-stat-val">{ strconv.Itoa(d.Stats.ExistingPlanets) }</span><span class="gal-stat-lbl">Existing planets</span></div>
			<div class="gal-stat"><span class="gal-stat-val">{ fnum(d.Stats.AvailableMissiles) }</span><span class="gal-stat-lbl">Available Missiles</span></div>
			<div class="gal-stat"><span class="gal-stat-val">{ fnum(d.Stats.GigaRecycler) }</span><span class="gal-stat-lbl">Giga Recycler</span></div>
			<div class="gal-stat"><span class="gal-stat-val">{ strconv.Itoa(d.Stats.FleetSlotsActive) }/{ strconv.Itoa(d.Stats.FleetSlotsTotal) }</span><span class="gal-stat-lbl">Fleet Slots</span></div>
			<div class="gal-stat"><span class="gal-stat-val">{ fnum(d.Stats.SpyProbes) }</span><span class="gal-stat-lbl">Spy Probes</span></div>
			<div class="gal-stat"><span class="gal-stat-val">{ fnum(d.Stats.Recycler) }</span><span class="gal-stat-lbl">Recycler</span></div>
		</div>
		<p class="gal-note">Player state, alliance and Giga Recycler have no engine source yet and render empty/zero.</p>
		<details class="gal-details"><summary>Diplomacy Colors</summary><p>Alliance diplomacy colouring arrives with the alliance system.</p></details>
		<details class="gal-details"><summary>Legend</summary><p>Fleet · Espionage · Message · Buddy request · Recycle · Colonize.</p></details>
	</div>
}

templ galaxyRow(sh Shell, slot models.GalaxySlot, g, s int) {
	<tr>
		<td class="gal-num">{ strconv.Itoa(slot.Position) }</td>
		<td class="gal-planet">
			if slot.Occupied {
				<img class="gal-planet-icon" src="/static/niburu/icons/planets.png" alt=""/>
				if slot.IsOwn {
					<span class="gal-own">({ slot.OwnerName })</span>
				} else {
					<span class="gal-other">{ slot.OwnerName }</span>
				}
			}
		</td>
		<td class="gal-moon">
			if slot.HasMoon {
				<img src="/static/niburu/icons/moon.png" alt="moon" title="Moon"/>
			}
		</td>
		<td>
			if slot.DebrisMetal > 0 || slot.DebrisCrystal > 0 {
				<span class="gal-debris-m">{ fnum(slot.DebrisMetal) }</span> / <span class="gal-debris-c">{ fnum(slot.DebrisCrystal) }</span>
			}
		</td>
		<td class="gal-player">{ slot.OwnerName }</td>
		<td class="gal-alliance"></td>
		<td class="gal-actions">
			@slotAction(sh, slot, g, s)
		</td>
	</tr>
}

templ slotAction(sh Shell, slot models.GalaxySlot, g, s int) {
	if slot.Occupied && !slot.IsOwn {
		@galaxyIcon(sh, g, s, slot.Position, "PLANET", "ATTACK", "fleet.png", "Fleet")
		@galaxyIcon(sh, g, s, slot.Position, "PLANET", "ESPIONAGE", "espionage.png", "Espionage")
		@galaxyDisabled("mesages.png", "Message")
		@galaxyDisabled("friend.png", "Buddy request")
	} else if !slot.Occupied && (slot.DebrisMetal > 0 || slot.DebrisCrystal > 0) {
		@galaxyIcon(sh, g, s, slot.Position, "DEBRIS_FIELD", "RECYCLE", "p_select_grab.png", "Recycle")
	} else if !slot.Occupied && !slot.Locked {
		@galaxyIcon(sh, g, s, slot.Position, "PLANET", "COLONIZE", "coloni.png", "Colonize")
	}
}

templ galaxyIcon(sh Shell, g, s, p int, targetType, mission, icon, label string) {
	<a class="gal-action" href={ templ.URL(fleetLinkMission(sh, g, s, p, targetType, mission)) } title={ label }>
		<img src={ "/static/niburu/icons/" + icon } alt={ label }/>
	</a>
}

templ galaxyDisabled(icon, label string) {
	<span class="gal-action is-disabled" title={ label + " — coming soon" }>
		<img src={ "/static/niburu/icons/" + icon } alt={ label }/>
	</span>
}

// ---- Messages body -------------------------------------------------------

templ MessagesBody(sh Shell, d ReportsData) {
	<div class="panel messages-panel">
		<div class="panel-title">Messages</div>
		<div class="msg-grid">
			for _, c := range d.Categories {
				@messageCell(c)
			}
		</div>
		<div class="grid gap-6">
			if len(d.Combat) > 0 || d.Active == "combat" || d.Active == "all" {
				@combatSection(d.Combat)
			}
			if len(d.Espionage) > 0 || d.Active == "spy" || d.Active == "all" {
				@espionageSection(d.Espionage)
			}
			if len(d.Expedition) > 0 || d.Active == "expedition" || d.Active == "all" {
				@expeditionSection(d.Expedition)
			}
		</div>
	</div>
}

templ messageCell(c MessageCategory) {
	if c.Backed {
		<a class={ "msg-cat " + c.Color } href={ templ.URL(c.Href) }>
			<span class="msg-cat-name">{ c.Label }</span>
			<span class="msg-cat-count">{ strconv.Itoa(c.Unread) }/{ strconv.Itoa(c.Count) }</span>
		</a>
	} else {
		<span class={ "msg-cat " + c.Color + " is-disabled" } title="Coming soon">
			<span class="msg-cat-name">{ c.Label }</span>
			<span class="msg-cat-count">0/0</span>
		</span>
	}
}

templ combatSection(reports []store.CombatReport) {
	<section>
		<h3 class="tech-group-title">Combat reports</h3>
		if len(reports) == 0 {
			<p class="text-sm text-slate-500">None.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="game-table">
					<thead><tr><th>ID</th><th>Where</th><th>Result</th><th class="num">Debris</th><th>When</th></tr></thead>
					<tbody>
						for _, rep := range reports {
							<tr>
								<td>#{ strconv.FormatInt(rep.ID, 10) }</td>
								<td>{ coord3(rep.Galaxy, rep.System, rep.Position) }</td>
								<td>{ rep.Result } ({ strconv.Itoa(rep.Rounds) } rounds)</td>
								<td class="num">{ fnum(rep.DebrisMetal) } / { fnum(rep.DebrisCrystal) }</td>
								<td>{ rep.CreatedAt.Format("02 Jan 15:04") }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ espionageSection(reports []store.EspionageReport) {
	<section>
		<h3 class="tech-group-title">Espionage reports</h3>
		if len(reports) == 0 {
			<p class="text-sm text-slate-500">None.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="game-table">
					<thead><tr><th>ID</th><th>Where</th><th class="num">Probes</th><th class="num">Score</th><th>When</th></tr></thead>
					<tbody>
						for _, rep := range reports {
							<tr>
								<td>#{ strconv.FormatInt(rep.ID, 10) }</td>
								<td>{ coord3(rep.Galaxy, rep.System, rep.Position) }</td>
								<td class="num">{ strconv.Itoa(rep.ProbesSent) }</td>
								<td class="num">{ strconv.Itoa(rep.Score) }</td>
								<td>{ rep.CreatedAt.Format("02 Jan 15:04") }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ expeditionSection(reports []store.ExpeditionReport) {
	<section>
		<h3 class="tech-group-title">Expedition reports</h3>
		if len(reports) == 0 {
			<p class="text-sm text-slate-500">None.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="game-table">
					<thead><tr><th>Where</th><th>Outcome</th><th>Message</th><th>When</th></tr></thead>
					<tbody>
						for _, rep := range reports {
							<tr>
								<td>{ coord3(rep.Galaxy, rep.System, rep.Position) }</td>
								<td>{ rep.Outcome }</td>
								<td class="max-w-md">{ rep.Title }</td>
								<td>{ rep.CreatedAt.Format("02 Jan 15:04") }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

// resLineLabel renders a resources-table row label: structures carry their
// level, the solar satellite its quantity, computed rows just their name.
func resLineLabel(l game.ProductionLine) string {
	switch {
	case l.Code == "212":
		return l.Name + " (Quantity " + fnum(l.Quantity) + ")"
	case l.Code != "":
		return l.Name + " (Level " + strconv.Itoa(l.Level) + ")"
	default:
		return l.Name
	}
}

// resAmount formats an hourly resource figure with thousands separators.
func resAmount(v float64) string {
	return fnumF(v)
}

// energyAmount formats a signed energy figure (the live client omits the plus
// on a surplus).
func energyAmount(v float64) string {
	n := int64(v)
	if n == 0 {
		return "0"
	}
	if n < 0 {
		return "-" + fnum(-n)
	}
	return fnum(n)
}
